{
  "mcpServers": {
    "bybit": {
      "command": "node",
      "args": [
        "web/scripts/start_bybit_mcp.mjs"
      ],
      "env": {
        "BYBIT_TESTNET": "true"
      }
    },
    "mt5ReadOnly": {
      "command": "node",
      "args": [
        "web/scripts/start_mt5_mcp.mjs"
      ],
      "env": {
        "NODE_USE_ENV_PROXY": "1"
      }
    },
    "metaeditor": {
      "type": "http",
      "url": "http://127.0.0.1:22345/mcp",
      "headers": {
        "Authorization": "Bearer ${MT5_APP_MCP_TOKEN:-}"
      }
    },
    "terminal": {
      "type": "http",
      "url": "http://127.0.0.1:22346/mcp",
      "headers": {
        "Authorization": "Bearer ${MT5_APP_MCP_TOKEN:-}"
      }
    },
    "marketdata": {
      "type": "http",
      "url": "https://www.metatrader.com/mcp",
      "headers": {
        "Authorization": "Bearer ${METATRADER_MARKETDATA_MCP_TOKEN:-}"
      }
    }
  }
}
