{
  "mcpServers": {
    "bybit": {
      "command": "node",
      "args": ["web/scripts/start_bybit_mcp.mjs"],
      "env": {
        "BYBIT_TESTNET": "true"
      }
    },
    "mt5ReadOnly": {
      "command": "node",
      "args": ["web/scripts/start_mt5_mcp.mjs"],
      "env": {
        "NODE_USE_ENV_PROXY": "1"
      }
    }
  }
}
