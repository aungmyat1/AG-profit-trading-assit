--- a/requirements.txt
+++ b/requirements.txt
@@ -1,14 +1,22 @@
 # No dependency mechanism existed before this file (packages were only present via the
 # system Python install). Versions below are what was verified against on 2026-08-26.
+#
+# PLATFORM NOTE (2026-09-21): MetaTrader5 publishes win_amd64 wheels only (verified on
+# PyPI for 5.0.5735: cp36..cp314, no Linux/macOS wheels). The PEP 508 environment marker
+# below makes it install only on Windows, so `pip install -r requirements.txt` succeeds
+# on every platform. On non-Windows machines tests/conftest.py's import-only MT5 stub
+# takes over and `live_mt5`-marked tests skip; nothing else in this file is Windows-only.
