 def _mt5_available():
-    import MetaTrader5 as mt5
-    return mt5.initialize()
+    try:
+        import MetaTrader5 as mt5
+        return bool(mt5.initialize())
+    except Exception:
+        # MetaTrader5 is absent, or tests/conftest.py's import-only portability
