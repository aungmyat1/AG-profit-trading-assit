{
  "servers": {
    "mt5ReadOnly": {
      "type": "stdio",
      "command": "node",
      "args": ["web/scripts/start_mt5_mcp.mjs"],
      "env": {
        "MT5_ENVIRONMENT": "DEMO",
        "VANTAGE-DEMO-LOGIN": "${input:mt5-demo-login}",
        "VANTAGE-DEMO_PASSWORD": "${input:mt5-demo-password}",
        "VANTAGE-DEMO-SERVER": "${input:mt5-demo-server}"
      }
    },
    "bybit": {
      "type": "stdio",
      "command": "node",
      "args": ["web/scripts/start_bybit_mcp.mjs"],
      "env": {
        "BYBIT_TESTNET": "true"
      }
    }
  },
  "inputs": [
    {
      "type": "promptString",
      "id": "mt5-demo-login",
      "description": "MT5 Demo account login ID"
    },
    {
      "type": "promptString",
      "id": "mt5-demo-password",
      "description": "MT5 Demo account password",
      "password": true
    },
    {
      "type": "promptString",
      "id": "mt5-demo-server",
      "description": "MT5 Demo broker server name"
    }
  ]
}