# Copy to src/.env and fill in real values. src/.env is gitignored -- never commit real
# credentials. See src/mt5/config.py (the only module that reads these) and
# src/mt5/account_guard.py (verifies the connected MT5 account matches these values
# before any order-send path is allowed to proceed).

# ── MT5 broker/account identity (Vantage Markets Demo) ──────────────────────
MT5_BROKER=VANTAGE
MT5_ENVIRONMENT=DEMO
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_TERMINAL_PATH=

# ── Telegram alerts (not yet wired into execution -- see PROJECT_STATUS.md) ─
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
